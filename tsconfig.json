{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node"], "useDefineForClassFields": true
  },
  "include": ["src", "bridge", "vite*.ts"]
}
